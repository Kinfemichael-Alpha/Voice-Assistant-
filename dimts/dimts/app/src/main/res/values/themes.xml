<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dimts" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/term_bg</item>
        <item name="android:statusBarColor">@color/term_bg</item>
        <item name="android:navigationBarColor">@color/term_bg</item>
        <item name="android:colorAccent">@color/term_prompt</item>
        <item name="android:textColorHint">#666666</item>
    </style>

    <style name="TermButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@color/term_button</item>
        <item name="android:textColor">@color/term_fg</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
